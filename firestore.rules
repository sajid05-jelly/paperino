rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isContributor() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "contributor";
    }

    function isOwner(resource) {
      return isSignedIn() && resource.data.uploaderId == request.auth.uid;
    }

    function isNotBlocked() {
      return isSignedIn() &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "blocked");
    }

    // ── Users collection ────────────────────────────────────────────────────
    match /users/{userId} {
      // Anyone signed in can read their own profile; admins can read all
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Split write into create and update to prevent role self-escalation
      allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.role == "student" && request.resource.data.status == "active";
      allow update: if (isSignedIn() && request.auth.uid == userId && isNotBlocked() &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']))) || isAdmin();
    }

    // ── Dynamic Subjects / Courses ──────────────────────────────────────────
    match /dynamic_subjects/{docId} {
      allow read: if true;
      allow create: if isAdmin() || (isContributor() && isNotBlocked());
      allow update, delete: if isAdmin();
    }

    // ── Study Materials ─────────────────────────────────────────────────────
    match /materials/{docId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isContributor() && 
        isNotBlocked() && 
        request.resource.data.status == "pending" && 
        request.resource.data.uploaderId == request.auth.uid
      );
      allow update: if isAdmin() || (
        isContributor() && 
        isNotBlocked() && 
        isOwner(resource) && 
        resource.data.status == "pending" && 
        request.resource.data.status == "pending"
      );
      allow delete: if isAdmin() || (
        isContributor() && 
        isNotBlocked() && 
        isOwner(resource) && 
        resource.data.status == "pending"
      );
    }

    // ── Semesters ───────────────────────────────────────────────────────────
    match /semesters/{semId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /semesters/{semId}/{rest=**} {
      allow read: if true;
      allow create: if isAdmin() || (isContributor() && isNotBlocked());
      allow update, delete: if isAdmin() || (isContributor() && isOwner(resource) && isNotBlocked());
    }

    // ── Bookmarks ───────────────────────────────────────────────────────────
    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && isNotBlocked() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ── Grades ──────────────────────────────────────────────────────────────
    match /grades/{gradeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && isNotBlocked() && request.resource.data.userId == request.auth.uid;
    }

    // ── Leaderboard / User Stats ─────────────────────────────────────────────
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isNotBlocked();
    }

    match /leaderboards/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Feedback ────────────────────────────────────────────────────────────
    match /user_feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isNotBlocked();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Settings (maintenance mode, AI status) ───────────────────────────────
    match /settings/{settingId} {
      allow read: if true;  // maintenance banner needs public read
      allow write: if isAdmin();
    }

    // ── AI Usage tracking (per-user, stored in users subcollection) ──────────
    match /users/{userId}/ai_usage/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── AI Credits (root collection) ─────────────────────────────────────────
    match /user_credits/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Note: writes to user_credits are handled exclusively by the Admin SDK on the server
      allow write: if false; 
    }

    // ── Team / Contributors list ─────────────────────────────────────────────
    match /team/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Contributor Requests ────────────────────────────────────────────────
    match /contributor_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && isNotBlocked() && request.resource.data.uid == request.auth.uid && request.resource.data.status == "pending";
      allow update, delete: if isAdmin();
    }

    // ── Blocked IPs / Users (admin-only) ────────────────────────────────────
    match /blocked_users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ── Notifications ────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // Users can read their own notifications only
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Users can only mark their own notifications as read (only 'read' field)
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // Any signed-in non-blocked user can create notifications.
      // This supports the client-side notifyAdmins() flow where a contributor
      // writes a notification targeted at admin UIDs.
      // Field validation ensures the required schema is present.
      allow create: if isSignedIn() && isNotBlocked()
                    && request.resource.data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'createdAt'])
                    && request.resource.data.read == false
                    && request.resource.data.userId is string
                    && request.resource.data.title is string
                    && request.resource.data.message is string;
      // Admins can delete notifications
      allow delete: if isAdmin();
    }

    // ── Deny all other paths by default ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
