rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin') ||
        (resource != null && 'createdBy' in resource.data && resource.data.createdBy == request.auth.uid)
      );
    }

    function isContributor() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "contributor";
    }

    function isOwner(res) {
      return isSignedIn() && res.data.uploaderId == request.auth.uid;
    }

    function isNotBlocked() {
      return isSignedIn() &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "blocked");
    }

    // ── Users collection ────────────────────────────────────────────────────
    match /users/{userId} {
      // Anyone signed in can read their own profile; admins can read all; signed-in users can query admin profiles
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        resource.data.role == "admin" || 
        resource.data.email in [
          "mohamedsajid.sa@gmail.com",
          "sudharajsekar2005@gmail.com",
          "admin.paperinoirfan27@gmail.com",
          "admin.paperinosam14@gmail.com"
        ]
      );
      // Split write into create and update to prevent role self-escalation
      allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.role == "student" && request.resource.data.status == "active";
      allow update: if (isSignedIn() && request.auth.uid == userId && isNotBlocked() &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']))) || isAdmin();
    }

    // ── Departments ─────────────────────────────────────────────────────────
    match /departments/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── Dynamic Subjects / Courses ──────────────────────────────────────────
    match /dynamic_subjects/{docId} {
      allow read: if true;
      allow create: if isAdmin() || (isContributor() && isNotBlocked());
      allow update, delete: if isAdmin();
    }

    // ── Study Materials ─────────────────────────────────────────────────────
    match /materials/{docId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isContributor() && 
        isNotBlocked() && 
        request.resource.data.status == "pending" && 
        request.resource.data.uploaderId == request.auth.uid
      );
      allow update: if isAdmin() || (
        isContributor() && 
        isNotBlocked() && 
        isOwner(resource) && 
        resource.data.status == "pending" && 
        request.resource.data.status == "pending"
      );
      allow delete: if isAdmin() || (
        isContributor() && 
        isNotBlocked() && 
        isOwner(resource) && 
        resource.data.status == "pending"
      );
    }

    // ── Semesters ───────────────────────────────────────────────────────────
    match /semesters/{semId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /semesters/{semId}/{rest=**} {
      allow read: if true;
      allow create: if isAdmin() || (isContributor() && isNotBlocked());
      allow update, delete: if isAdmin() || (isContributor() && isOwner(resource) && isNotBlocked());
    }

    // ── Bookmarks ───────────────────────────────────────────────────────────
    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── Grades ──────────────────────────────────────────────────────────────
    match /grades/{gradeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && isNotBlocked() && request.resource.data.userId == request.auth.uid;
    }

    // ── Leaderboard / User Stats ─────────────────────────────────────────────
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isNotBlocked();
    }

    match /leaderboards/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Feedback ────────────────────────────────────────────────────────────
    match /user_feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isNotBlocked();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Settings (maintenance mode, AI status) ───────────────────────────────
    match /settings/{settingId} {
      allow read: if true;  // maintenance banner needs public read
      allow write: if isAdmin();
    }

    // ── Platform Stats ────────────────────────────────────────────────────────
    match /platform_stats/{document=**} {
      allow read: if isAdmin();
    }

    // ── AI Usage tracking (per-user, stored in users subcollection) ──────────
    match /users/{userId}/ai_usage/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── AI Credits (root collection) ─────────────────────────────────────────
    match /user_credits/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Note: writes to user_credits are handled exclusively by the Admin SDK on the server
      allow write: if false; 
    }

    // ── Team / Contributors list ─────────────────────────────────────────────
    match /team/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Platform Configuration ──────────────────────────────────────────────
    match /platform_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Contributor Requests ────────────────────────────────────────────────
    match /contributor_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && isNotBlocked() && request.resource.data.uid == request.auth.uid && request.resource.data.status == "pending";
      allow update, delete: if isAdmin();
    }

    // ── Blocked IPs / Users (admin-only) ────────────────────────────────────
    match /blocked_users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ── Notifications ────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isSignedIn() && isNotBlocked()
                    && request.resource.data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'createdAt'])
                    && request.resource.data.read == false
                    && request.resource.data.userId is string
                    && request.resource.data.title is string
                    && request.resource.data.message is string;
      allow delete: if isAdmin();
    }

    // ── Pulse Blacklist (Admin Only) ─────────────────────────────────────────
    match /pulse_blacklist/{blacklistId} {
      allow read, write: if isAdmin();
    }

    // ── Pulse Queue (Admin Only) ─────────────────────────────────────────────
    match /pulse_queue/{queueId} {
      allow read, write: if isAdmin();
    }

    // ── Pulse Updates ────────────────────────────────────────────────────────
    match /pulse_updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Deny all other paths by default ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
