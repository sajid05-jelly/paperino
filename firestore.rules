rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the current user has the admin role in the database
    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email in [
          "mohamedsajid.sa@gmail.com",
          "sudharajsekar2005@gmail.com",
          "admin.paperinoirfan27@gmail.com",
          "admin.paperinosam14@gmail.com",
          "gameplayitlifeitis@gmail.com"
        ])
      );
    }

    // ── Users collection ────────────────────────────────────────────────────
    match /users/{userId} {
      // Any signed-in user can read profiles (needed for notifyAdmins lookup & leaderboard)
      allow read: if isSignedIn();
      
      // Users can only create their own profile as a student
      allow create: if isSignedIn() && request.auth.uid == userId && 
        request.resource.data.role == "student" && request.resource.data.status == "active";
      
      // Users can update their own profile (but not role/status/contributorLevel/premium/points), UNLESS they are an admin OR
      // their email is in the hardcoded admin list (allows initial admin promotion after create)
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'contributorLevel', 'premiumStartDate', 'premiumEndDate', 'uploads', 'contributionPoints'])) ||
          (request.resource.data.role == "admin" && request.resource.data.email in [
            "mohamedsajid.sa@gmail.com",
            "sudharajsekar2005@gmail.com",
            "admin.paperinoirfan27@gmail.com",
            "admin.paperinosam14@gmail.com",
            "gameplayitlifeitis@gmail.com"
          ])
        )) || isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    // ── Departments ─────────────────────────────────────────────────────────
    match /departments/{docId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.status == "pending" || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── Dynamic Subjects / Courses ──────────────────────────────────────────
    match /dynamic_subjects/{docId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.status == "pending" || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── Study Materials ─────────────────────────────────────────────────────
    match /materials/{docId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.status == "pending" || isAdmin());
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.uploaderId == request.auth.uid && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
      );
      allow delete: if isAdmin() || (
        isSignedIn() && 
        resource.data.uploaderId == request.auth.uid && 
        resource.data.status == "pending"
      );
    }

    // ── Semesters ───────────────────────────────────────────────────────────
    match /semesters/{semId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /semesters/{semId}/{rest=**} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.uploaderId == request.auth.uid);
    }

    // ── Grades ──────────────────────────────────────────────────────────────
    match /grades/{gradeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ── Leaderboard / User Stats ─────────────────────────────────────────────
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /leaderboards/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Feedback ────────────────────────────────────────────────────────────
    match /user_feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── Settings (maintenance mode, AI status) ───────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Platform Stats ────────────────────────────────────────────────────────
    match /platform_stats/{document=**} {
      allow read: if isAdmin();
    }

    // ── AI Usage tracking (per-user, stored in users subcollection) ──────────
    match /users/{userId}/ai_usage/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── AI Credits (root collection) ─────────────────────────────────────────
    match /user_credits/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false; 
    }

    // ── Team / Contributors list ─────────────────────────────────────────────
    match /team/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Platform Configuration ──────────────────────────────────────────────
    match /platform_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Contributor Requests ────────────────────────────────────────────────
    match /contributor_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == "pending";
      allow update, delete: if isAdmin();
    }

    // ── Blocked IPs / Users (admin-only) ────────────────────────────────────
    match /blocked_users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ── Notifications ────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'createdAt'])
                    && request.resource.data.read == false
                    && request.resource.data.userId is string
                    && request.resource.data.title is string
                    && request.resource.data.message is string;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── Pulse Blacklist (Admin Only) ─────────────────────────────────────────
    match /pulse_blacklist/{blacklistId} {
      allow read, write: if isAdmin();
    }

    // ── Pulse Queue (Admin Only) ─────────────────────────────────────────────
    match /pulse_queue/{queueId} {
      allow read, write: if isAdmin();
    }

    // ── Pulse Updates ────────────────────────────────────────────────────────
    match /pulse_updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // ── Survival Notes / Senior Insights ────────────────────────────────────
    match /survival_notes/{noteId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.status == "pending" || isAdmin());
      allow update: if isAdmin() || (
        isSignedIn() && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'subjectId', 'departmentId', 'semesterId', 'category', 'content', 'contributorId', 'contributorName', 'createdAt']))
      );
      allow delete: if isAdmin();
    }

    // ── Deny all other paths by default ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
